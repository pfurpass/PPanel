# Proxmox VE connection
# Hostname or IP of your Proxmox host (no protocol, no port)
PROXMOX_HOST=192.168.1.10
# API port, defaults to 8006 if omitted
PROXMOX_PORT=8006

# API token: create one in Proxmox under
# Datacenter -> Permissions -> API Tokens (uncheck "Privilege Separation"
# if you want the token to inherit the user's full permissions, or assign
# the token its own role/ACL entry with the permissions PPanel needs:
# VM.Audit, VM.PowerMgmt, VM.Console, VM.Allocate, Datastore.Audit, Datastore.AllocateSpace)
#
# Token ID has the form  <user>@<realm>!<token-name>, e.g. root@pam!ppanel
PROXMOX_TOKEN_ID=root@pam!ppanel
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# Set to "true" only if your Proxmox host has a certificate signed by a
# trusted CA. Leave "false" for the default Proxmox self-signed certificate.
PROXMOX_VERIFY_SSL=false
